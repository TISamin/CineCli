# Spring datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/cinemaseat
SPRING_DATASOURCE_USERNAME=cinemaseat
SPRING_DATASOURCE_PASSWORD=cinemaseat

# Hold
HOLD_TTL_SECONDS=120

# Gateway (addendum B1, B11)
GATEWAY_URL=http://gateway:9000
GATEWAY_CALLBACK_URL=http://api:8080/api/payments/callback
GATEWAY_SECRET=z2p-2026-secret
GATEWAY_REQUEST_TIMEOUT_MS=10000

# OTP
OTP_CALLBACK_URL=http://api:8080/api/otp/callback
OTP_MAX_VERIFY_ATTEMPTS=5

# Database pool (addendum A5, D12)
DB_POOL_MAX=30